# Backend Configuration
MODEL_PATH=/app/weights/best.pt
DB_PATH=/app/db/sparrow.db
UPLOADS_DIR=/app/uploads
RESULTS_DIR=/app/results

# Model Parameters
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.5

# Patch-based (tiled) inference — used when the "patch" flag is sent to /api/detect
PATCH_SHAPE_X=640
PATCH_SHAPE_Y=640
PATCH_OVERLAP_X=25
PATCH_OVERLAP_Y=25
PATCH_NMS_THRESHOLD=0.25
PATCH_MATCH_METRIC=IOS
PATCH_CONFIDENCE_THRESHOLD=0.5
PATCH_MERGE_IOU=0.5
